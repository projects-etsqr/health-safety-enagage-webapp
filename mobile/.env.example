# Android emulator -> host machine is reached via 10.0.2.2.
# iOS simulator can use http://localhost:8000/api/v1
# A physical device must use your machine's LAN IP, e.g. http://192.168.1.50:8000/api/v1
#
# NOTE: bare React Native does not auto-load .env. Set the default in
# src/constants/config.ts, or add a lib like react-native-dotenv.
API_BASE_URL=http://10.0.2.2:8000/api/v1
