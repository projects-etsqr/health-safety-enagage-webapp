{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    
    "paths": {
      "@expo/vector-icons": ["./src/shims/expoVectorIcons"]
    }
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "**/__tests__/*", "**/__mocks__/*", "supervisorMobileApp", "workerMobileApp", "managermobileapp"]
}
